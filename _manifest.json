{
  "manifest_version": 2,
  "id": "tianditongcuo.partner-game-pro",
  "version": "2.0.2",
  "name": "今日老婆 Pro+",
  "description": "基于随机抽签演化的群聊伴侣互动游戏系统（支持抽、娶、抢、甩等互动玩法）。Pro+ 维护分支，持续扩展中。",
  "author": {
    "name": "tianditongcuo",
    "url": "https://github.com/tianditongcuo"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/tianditongcuo/partner-game",
    "issues": "https://github.com/tianditongcuo/partner-game/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "game",
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0"
    }
  ],
  "capabilities": [
    "config.get",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
